{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and logs windows",
  "windows": ["main", "logs"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:event:default"
  ]
}