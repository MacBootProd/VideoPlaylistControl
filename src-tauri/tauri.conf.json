{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoPlaylistControl",
  "version": "1.0.0",
  "identifier": "com.macbootprod.videoplaylistcontrol",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Video Playlist Control",
        "width": 1900,
        "height": 1069,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true
      },
      {
        "label": "logs",
        "url": "log.html",
        "title": "VPC Logs",
        "width": 700,
        "height": 500,
        "visible": false,
        "resizable": true
    }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../src/assets/VPC-logo.ico",
      "../src/assets/VPC-logo.icns",
      "../src/assets/VPC-logo.png"
    ]
  }
}